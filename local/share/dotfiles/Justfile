set quiet := true

[group("system")]
battery:
    upower -i /org/freedesktop/UPower/devices/battery_BAT0

[group("system")]
cleanup:
    run0 podman image prune -af
    run0 podman volume prune -f
    podman image prune -af
    podman volume prune -f
    flatpak uninstall --unused
    brew autoremove
    brew cleanup
    spacefin-dotfiles cleanup

[group("system")]
bios:
    #!/usr/bin/bash
    if [ -d /sys/firmware/efi ]; then
        read -rp 'The system will reboot into UEFI firmware settings. Proceed? (y/N) ' proceed
        if [[ "$proceed" == [Yy]* ]]; then
            systemctl reboot --firmware-setup
        fi
    else
        echo "Rebooting to legacy BIOS from OS is not supported."
    fi

[group("system")]
logs-this-boot:
    run0 journalctl -b 0

[group("system")]
logs-last-boot:
    run0 journalctl -b -1

[group("system")]
update:
    ~/.local/share/dotfiles/scripts/update.sh

[group('DOOM')]
powerwash:
    #!/usr/bin/bash
    if command -v bctl &>/dev/null; then
        exec bctl powerwash
    fi

    echo "Warning: This is an experimental feature that will reset this device to its factory state."
    read -p "Do you want to continue? (y/N): " CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo "Powerwash cancelled."
        exit 0
    fi
    read -p "Are you sure? (y/N): " CONFIRM2
    if [[ ! "$CONFIRM2" =~ ^[Yy]$ ]]; then
        echo "Powerwash cancelled."
        exit 0
    fi

    sudo bootc install reset --experimental

[group("setups")]
setup-modding:
    echo ""
    echo "Installing r2modman"
    echo ""
    TEMP_FILE="/tmp/r2modman.flatpak"
    curl -L "https://github.com/ebkr/r2modmanPlus/releases/download/v3.2.15/r2modman-3.2.15-x86_64.flatpak" -o "$TEMP_FILE"
    run0 flatpak install -y --system "$TEMP_FILE"
    rm "$TEMP_FILE"
    echo ""
    echo "Installing Curseforge app"
    echo ""
    TEMP_FILE="/tmp/curseforge.AppImage"
    flatpak install -y --system flathub it.mijorus.gearlever
    curl -L "https://curseforge.overwolf.com/downloads/curseforge-latest-linux.AppImage" -o "$TEMP_FILE"
    flatpak run it.mijorus.gearlever --integrate "$TEMP_FILE" -y --replace
    echo ""
    echo "Installing Proton tools"
    echo ""
    flatpak install -y --system flathub net.davidotek.pupgui2
    flatpak install -y --system flathub com.github.Matoking.protontricks
    echo ""
    echo "Modding setup finished!"

